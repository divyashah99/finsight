# ─── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Market data ────────────────────────────────────────────────────────────
# Market data now comes from Yahoo Finance (yfinance) — keyless, no daily cap.
# The vars below are legacy/optional (kept for backward compat) and unused.
ALPHAVANTAGE_API_KEY=demo
ALPHAVANTAGE_RATE_PER_MIN=5
ALPHAVANTAGE_RATE_PER_DAY=25

# ─── Storage ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
DATABASE_URL_SYNC=postgresql://finsight:finsight@localhost:5432/finsight

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Hybrid collection (named dense + BM25 sparse vectors). Bump the name if you
# change the embedding model / schema so a fresh collection is created.
QDRANT_COLLECTION=sec_filings_hybrid

# ─── SEC ────────────────────────────────────────────────────────────────────
# EDGAR requires a User-Agent identifying you. Replace with your name + email.
SEC_USER_AGENT=FinSight Research contact@example.com

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=local
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ─── Observability (LangSmith) ───────────────────────────────────────────────
# Optional. When LANGSMITH_TRACING=true and a key is set, every research/chat run
# is traced (supervisor decisions, specialist sub-agents, tool calls, tokens).
# Also required to run the evaluation suite (apps/api/evals). Leave false locally.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
